# =========================================================================
# AI Study Buddy Agent Configuration (.env.example)
# =========================================================================

# LLM Mode Toggle (Pillar 7)
# Set to true for offline deterministic testing with zero API keys and zero cost.
# Set to false to connect to a live LLM provider.
USE_FAKE_LLM=false

# Real LLM Provider ('gemini', 'openai', or 'ollama')
REAL_LLM_PROVIDER=gemini

# Ollama server (keep localhost for local development; use a reachable HTTPS URL on Render)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=
OLLAMA_PROXY_TOKEN=

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Safety Guardrails (Pillar 6)
MAX_STEPS=8
REQUIRE_CONFIRMATION_FOR_SENSITIVE_TOOLS=true

# Storage & Logging Paths
MEMORY_FILE_PATH=storage/memory.json
NOTES_STORAGE_DIR=storage/notes
LOG_FILE_PATH=logs/agent_audit.log

